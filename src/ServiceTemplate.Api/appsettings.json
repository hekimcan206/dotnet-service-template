{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AllowedHosts": "*"
}
