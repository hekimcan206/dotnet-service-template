# Copy to .env to override the docker compose defaults. Defaults are for local development only.
API_PORT=58080
POSTGRES_PORT=58432
POSTGRES_PASSWORD=postgres-dev-only
MIGRATOR_PASSWORD=migrator-dev-only
APP_PASSWORD=app-dev-only

# Set to export traces/metrics, e.g. with `docker compose --profile observability up`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
